# Discord application credentials
CLIENT_ID=
CLIENT_SECRET=
DISCORD_TOKEN=

# Express session signing secret (any long random string)
SESSION_SECRET=

PORT=3000

# OAuth2 redirect URIs registered on the Discord Developer Portal
VERIFY_REDIRECT_URI=https://your-domain.example.com/auth/verify/callback
DASHBOARD_REDIRECT_URI=https://your-domain.example.com/auth/discord/callback

# MongoDB connection string (Atlas or self-hosted). ALL bot data lives here —
# guild configs, OAuth states, and authorized users. No local files are used.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>
